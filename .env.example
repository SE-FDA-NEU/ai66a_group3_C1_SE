DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL 18 example (supply the real URL through a secret manager):
# DATABASE_URL=postgresql+psycopg://app@db.example.com/movie_app?sslmode=verify-full
# Required for server-side TMDb catalogue import in Sprint 3 dev/staging/demo.
# Set a real value only in the root gitignored .env/server environment.
# Automated tests use synthetic fixtures/mocks and no real token.
TMDB_READ_ACCESS_TOKEN=
# Render runtime (set privately in its dashboard; see docs/s5-t03-deployment.md):
# APP_ENV=production
# SESSION_COOKIE_SECURE=true
# PGSSLROOTCERT=system
# NLP_INDEX_PATH=/tmp/ai66a-overview-tfidf-v1.json
# FORWARDED_ALLOW_IPS=<trusted Render ingress IP addresses or networks>
