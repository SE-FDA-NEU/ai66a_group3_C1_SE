@startuml
title Catalogue and account ERD - C03 migration contract

hide circle
hide methods
skinparam linetype ortho
skinparam shadowing false
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #2F5597
  HeaderBackgroundColor #D9E8FB
}

entity "users" as users {
  * id : TEXT <<PK>>
  --
  * email_normalized : TEXT <<UQ>>
  * password_hash : TEXT
  * created_at : DATETIME
}

entity "auth_sessions" as auth_sessions {
  * session_digest : TEXT <<PK>>
  --
  * user_id : TEXT <<FK>>
  * created_at : DATETIME
  * expires_at : DATETIME
  invalidated_at : DATETIME <<NULL>>
}

entity "catalogue_revisions" as rev {
  * id : TEXT <<PK>>
  --
  * provider : TEXT
  * created_at : DATETIME
  completed_at : DATETIME <<NULL>>
}

entity "catalogue_state" as active_state {
  * id : INTEGER <<PK>>
  --
  active_revision_id : TEXT <<FK, NULL, UQ>>
  * updated_at : DATETIME
}

entity "catalog_movies" as movie_rows {
  * id : TEXT <<PK>>
  --
  * catalogue_revision_id : TEXT <<FK>>
  * source : TEXT <<UQ(source, source_id)>>
  * source_id : TEXT <<UQ(source, source_id)>>
  * title : TEXT
  release_year : INTEGER <<NULL>>
  overview : TEXT <<NULL>>
  popularity_score : REAL <<NULL>>
  vote_average : REAL <<NULL>>
  vote_count : INTEGER <<NULL>>
  * source_fetched_at : DATETIME
}

entity "genres" as genres {
  * id : INTEGER <<PK>>
  --
  * name : TEXT
}

entity "movie_genres" as movie_genre_links {
  * movie_id : TEXT <<PK, FK>>
  * genre_id : INTEGER <<PK, FK>>
}

entity "viewer_genre_preferences" as viewer_genre_preferences {
  * user_id : TEXT <<PK, FK>>
  * genre_id : INTEGER <<PK, FK>>
}

entity "viewer_ratings" as viewer_ratings {
  * user_id : TEXT <<PK, FK>>
  * movie_id : TEXT <<PK, FK>>
  --
  * value : INTEGER <<CHECK 1..5>>
  * updated_at : DATETIME
}

entity "import_runs" as imports {
  * id : TEXT <<PK>>
  --
  * provider : TEXT
  * status : TEXT
  * started_at : DATETIME
  completed_at : DATETIME <<NULL>>
  catalogue_revision_id : TEXT <<FK, NULL>>
  * inserted_count : INTEGER
  * updated_count : INTEGER
  * rejected_count : INTEGER
}

users "1" -- "0..*" auth_sessions
users "1" -- "0..*" viewer_genre_preferences
users "1" -- "0..*" viewer_ratings
genres "1" -- "0..*" viewer_genre_preferences
rev "1" -- "0..*" movie_rows
rev "0..1" -- "0..1" active_state
rev "0..1" -- "0..*" imports
movie_rows "1" -- "0..*" movie_genre_links
genres "1" -- "0..*" movie_genre_links
movie_rows "1" -- "0..*" viewer_ratings

legend bottom
  | Notation | Meaning |
  | * | NOT NULL |
  | PK | Primary key |
  | FK | Foreign key |
  | UQ | Unique constraint |
  | 1 | Exactly one |
  | 0..1 | Zero or one |
  | 0..* | Zero or many |

  This is the C03 catalogue/account migration contract.
  Catalogue tables and users have executable Alembic migrations.
  Other account tables remain planned until their owning tasks are merged.
endlegend
@enduml
