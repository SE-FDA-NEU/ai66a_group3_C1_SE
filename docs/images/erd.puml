@startuml
title Catalogue and account ERD - current migrations

hide circle
hide methods
skinparam linetype ortho
skinparam shadowing false
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #2F5597
  HeaderBackgroundColor #D9E8FB
}

entity "users" as users {
  * id : TEXT <<PK>>
  --
  * email_normalized : TEXT <<UQ>>
  * password_hash : TEXT
  * created_at : DATETIME
}

entity "auth_sessions" as auth_sessions {
  * token_digest : TEXT <<PK>>
  --
  * user_id : TEXT <<FK>>
  * created_at : DATETIME
  * expires_at : DATETIME
  revoked_at : DATETIME <<NULL>>
}

entity "catalogue_revisions" as rev {
  * id : TEXT <<PK>>
  --
  * provider : TEXT
  * created_at : DATETIME
  * inserted_movie_count : INTEGER
  * updated_movie_count : INTEGER
  * rejected_movie_count : INTEGER
}

entity "catalogue_state" as active_state {
  * id : INTEGER <<PK>>
  --
  * active_revision_id : TEXT <<FK, UQ>>
  * updated_at : DATETIME
}

entity "catalog_movies" as movie_rows {
  * id : TEXT <<PK>>
  --
  * catalogue_revision_id : TEXT <<FK>>
  * source : TEXT <<UQ(source, source_id)>>
  * source_id : TEXT <<UQ(source, source_id)>>
  * title : TEXT
  release_year : INTEGER <<NULL>>
  overview : TEXT <<NULL>>
  popularity_score : REAL <<NULL>>
  vote_average : REAL <<NULL>>
  vote_count : INTEGER <<NULL>>
  * source_fetched_at : DATETIME
}

entity "genres" as genres {
  * id : INTEGER <<PK>>
  * name : TEXT
}

entity "movie_genres" as movie_genre_links {
  * movie_id : TEXT <<PK, FK>>
  * genre_id : INTEGER <<PK, FK>>
}

users "1" -- "0..*" auth_sessions
rev "1" -- "0..*" movie_rows
rev "0..1" -- "0..1" active_state
movie_rows "1" -- "0..*" movie_genre_links
genres "1" -- "0..*" movie_genre_links

legend bottom
  | Notation | Meaning |
  | * | NOT NULL |
  | PK | Primary key |
  | FK | Foreign key |
  | UQ | Unique constraint |
  | 1 | Exactly one |
  | 0..1 | Zero or one |
  | 0..* | Zero or many |

  Only tables created by the current Alembic migrations are shown.
endlegend
@enduml
