@startuml
title AI Movie Recommendation System - Account-aware activity flow

start

:Open / public home;

if (Use public discovery?) then (yes)
  if (Browse popular movies?) then (yes)
    :Open /popular;
  else (search)
    :Open /search or /about-recommendations;
  endif
  :Open /movies/:movieId when a movie is selected;
  if (Save a rating while signed out?) then (yes)
    :Open /login;
  else (no)
    :Return to the public list;
  endif
else (personalise)
  if (Already registered?) then (yes)
    :Open /login;
  else (no)
    :Open /register;
    :Create account with a unique email;
    :Open /login;
  endif

  :Authenticate the account;
  :Open /recommendations;

  if (Saved favourite genres?) then (yes)
    :Request personal recommendations;
  else (no)
    :Show non-personalised popular fallback;
    :Open /preferences from Enter preferences;
    :Select 1 to 5 genres and save them for the current account;
    :Open /recommendations;
  endif

  if (Matching movies found?) then (yes)
    :Show at most 10 distinct recommended movies and reasons;
    :Optionally filter the current displayed list;
    :Open /movies/:movieId;
    :View public similar movies;
    if (Rate this movie?) then (yes)
      :Save/update the current account rating from 1 to 5;
    endif
  else (no)
    :Show no-match message and popular alternatives;
    :Retry or open /preferences to edit genres;
  endif

  if (Manage account data?) then (yes)
    :Open /profile;
    :Confirm reset of only this account's genres and ratings;
  endif
  :Sign out and return to /;
endif

stop
@enduml
